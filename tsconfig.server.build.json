{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.build.tsbuildinfo",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "./build",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["server/**/*.ts", "src/lib/types.ts"]
}
